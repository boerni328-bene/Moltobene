<?xml version="1.0" encoding="UTF-8"?>
<!--
  Prüfsummen für Bausteine, die nicht signiert sind (#41). Tesseract4Android kommt von JitPack, das Pakete
  selbst aus GitHub-Quellen baut und nicht signiert. Stimmt eine Datei nicht mit der hier eingetragenen
  Prüfsumme überein, bricht der Build ab – ein unbemerkt ausgetauschtes Paket kommt so nie in die App.

  Alle anderen Bausteine (Google, Maven Central) gelten als vertrauenswürdig und werden hier nicht geprüft.
  Bei einem Update von Tesseract4Android (z. B. durch Dependabot) die Prüfsummen bewusst neu eintragen:
  die Dateien von https://jitpack.io/cz/adaptech/tesseract4android/tesseract4android-openmp/<Version>/
  laden, mit sha256sum prüfen und mit den Angaben in der .module-Datei vergleichen.
-->
<verification-metadata xmlns="https://schema.gradle.org/dependency-verification"
                       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                       xsi:schemaLocation="https://schema.gradle.org/dependency-verification https://schema.gradle.org/dependency-verification/dependency-verification-1.3.xsd">
   <configuration>
      <verify-metadata>true</verify-metadata>
      <verify-signatures>false</verify-signatures>
      <trusted-artifacts>
         <!-- Alles außer der Gruppe cz.adaptech.tesseract4android -->
         <trust group="^(?!cz[.]adaptech[.]tesseract4android$).*$" regex="true"/>
      </trusted-artifacts>
   </configuration>
   <components>
      <component group="cz.adaptech.tesseract4android" name="tesseract4android-openmp" version="4.9.0">
         <artifact name="tesseract4android-openmp-4.9.0.aar">
            <sha256 value="02b5968cc482ef6162dcdecad0000cc28f120becc089ccca2eefb8fadc12ab2b" origin="jitpack.io, geprüft am 2026-10-02"/>
         </artifact>
         <artifact name="tesseract4android-openmp-4.9.0.module">
            <sha256 value="09fdd9549ef9ae92b09c78ec103af5d7036f565fcd1d02c397fdb3e82cedeba0" origin="jitpack.io, geprüft am 2026-10-02"/>
         </artifact>
         <artifact name="tesseract4android-openmp-4.9.0.pom">
            <sha256 value="ad50083e8302482da79e69709da4373ac6bd4659ab9aed215985e1f74b22ba13" origin="jitpack.io, geprüft am 2026-10-02"/>
         </artifact>
      </component>
   </components>
</verification-metadata>
