<?xml version="1.0" encoding="utf-8"?>
<!--
  Nur verschlüsselte Verbindungen (https) und nur die Zertifikate des Systems (#55). Ab Android 9 ist das
  ohnehin so, Android 8 erlaubt unverschlüsselte Verbindungen sonst noch.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
