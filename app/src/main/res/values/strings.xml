    <!-- Neu in Version … (Texte zu WhatsNew.VERSION_NAME) -->
    <string name="whats_new_title">New in version %1$s</string>
    <string-array name="whats_new_items">
        <item>Tags: recipes can get bundled tags such as “Sauces”, “Desserts” or “Soups”, plus tags of their own. The collection can be filtered by one or more tags at once, with the number of recipes per tag.</item>
        <item>Cooking bar in the recipe: “Previous”, “Read aloud”, “Next” and “Ingredients” move through the steps and read them aloud on tap, with voices that work without internet.</item>
        <item>Home screen: “What to cook today?” suggests a recipe from the collection (favorites preferred); “Another recipe” picks a different one.</item>
        <item>Home screen: “Recently opened” shows the last recipes opened. This list stays on the device only.</item>
    </string-array>

