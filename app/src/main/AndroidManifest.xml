<?xml version="1.0" encoding="utf-8"?>
<!--
  Die App braucht keine einzige Berechtigung: Fotos kommen über die Android-Fotoauswahl
  bzw. die Kamera-App, Sicherungen über den Android-Dateidialog. Kein Internet.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      Datensicherung (#12): keine Cloud-Sicherung ins Google-Konto (Vision: „keine Cloud“).
      Ab Android 12 bleibt der direkte Umzug von Handy zu Handy erlaubt (data_extraction_rules);
      Android 8–11 kennt diese Trennung nicht, dort ist die Android-Sicherung ganz ausgeschlossen.
      Gesichert wird über die eigene Sicherungsdatei in den Einstellungen.
    -->
    <application
        android:name=".MoltobeneApplication"
        android:allowBackup="true"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Moltobene">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Übergabe von Dateien an andere Apps: Kamera-App und Teilen (nur die Ordner in file_paths.xml). -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
