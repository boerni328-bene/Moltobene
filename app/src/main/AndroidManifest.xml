<?xml version="1.0" encoding="utf-8"?>
<!--
  Die App braucht keine einzige Berechtigung: Fotos kommen über die Android-Fotoauswahl,
  die Kamera-App oder „Teilen mit…“, Sicherungen über den Android-Dateidialog. Kein Internet.
  Der Build prüft die fertige APK gegen eine Erlaubt-Liste (build.yml, „Berechtigungen prüfen“).
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      #49: ONNX Runtime (Texterkennung) bringt eine Telemetrie von Microsoft mit, die Nutzungsdaten ins Internet
      senden kann, und dafür diese beiden Berechtigungen. Beides wird hier entfernt; zusätzlich schaltet
      MoltobeneApplication die Telemetrie über ORT_DISABLE_TELEMETRY ab.
    -->
    <uses-permission android:name="android.permission.INTERNET" tools:node="remove" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" tools:node="remove" />

    <!--
      Datensicherung (#12): keine Cloud-Sicherung ins Google-Konto (Vision: „keine Cloud“).
      Ab Android 12 bleibt der direkte Umzug von Handy zu Handy erlaubt (data_extraction_rules);
      Android 8–11 kennt diese Trennung nicht, dort ist die Android-Sicherung ganz ausgeschlossen.
      Gesichert wird über die eigene Sicherungsdatei in den Einstellungen.
    -->
    <application
        android:name=".MoltobeneApplication"
        android:allowBackup="true"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Moltobene">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!--
              „Teilen mit…“ (#46): Bildschirmfotos und Bilder aus anderen Apps direkt übernehmen.
              Angenommen werden nur content://-Adressen, die Bilder werden sofort kopiert (siehe IncomingImages).
              Dafür ist keine Berechtigung nötig.
            -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
            </intent-filter>
            <!--
              „Teilen mit…“ für Text: Rezepttext aus WhatsApp, E-Mail oder Notizen, Links aus dem Browser.
              Der Text wird gekürzt und nur als Text verwendet (siehe IncomingText); geöffnet wird nichts.
            -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <!--
          #49: Startbaustein der Microsoft-Telemetrie aus ONNX Runtime entfernen. Er liefe sonst bei jedem App-Start.
          Nur dieser eine; der gemeinsame androidx.startup.InitializationProvider bleibt.
        -->
        <provider
            android:name="ai.onnxruntime.TelemetryInitializer"
            android:authorities="${applicationId}.onnxruntime_telemetry_initializer"
            tools:node="remove" />

        <!-- Übergabe von Dateien an andere Apps: Kamera-App und Teilen (nur die Ordner in file_paths.xml). -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
